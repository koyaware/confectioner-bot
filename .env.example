# Application secret for encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
APP_SECRET=

# Superadmin Telegram ID (your Telegram user ID, get from @userinfobot)
SUPERADMIN_TELEGRAM_ID=
# Comma/space separated Telegram IDs that should also get owner-level rights (for support/ops)
ADMIN_TELEGRAM_IDS=

# Database path
DATABASE_PATH=./data.db

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Node environment
NODE_ENV=development
